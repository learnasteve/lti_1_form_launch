APP_NAME=lti-mvp
PORT=7999

# Set this when testing through a public URL (ngrok, reverse proxy, etc.)
PUBLIC_BASE_URL=http://localhost:7999

LTI_URL=https://dev.let.media.kyoto-u.ac.jp/avery_analytics/lti/login

# Accept launches within +/- 5 minutes by default
TIMESTAMP_SKEW_SECONDS=300
NONCE_TTL_SECONDS=300

# At least one LTI 1.1 consumer credential pair
LTI_CONSUMER_KEY_1=consumer_key_123
LTI_SHARED_SECRET_1=secret123

# Optional additional credential pairs
# LTI_CONSUMER_KEY_2=another-key
# LTI_SHARED_SECRET_2=another-secret
